{
	"name": "@sjvair/map-sdk",
	"description": "Svelte 5 map components for SJVAir air-quality data",
	"version": "0.1.0-beta.14",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/SJVAir/map-sdk"
	},
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-package -i src/lib -o dist",
		"prepack": "npm run build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:client": "vitest run --project client",
		"test:browser": "vitest run --project browser",
		"test:bundle": "npm run build && node scripts/check-bundle.mjs",
		"test:licenses": "npm run build && node scripts/check-licenses.mjs",
		"test:e2e": "playwright test"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"svelte": "./dist/index.js",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./stores": {
			"svelte": "./dist/stores/index.js",
			"types": "./dist/stores/index.d.ts",
			"default": "./dist/stores/index.js"
		},
		"./data": {
			"svelte": "./dist/data/index.js",
			"types": "./dist/data/index.d.ts",
			"default": "./dist/data/index.js"
		},
		"./messages/en.json": {
			"default": "./dist/data/messages/en.json"
		},
		"./theme.css": {
			"default": "./dist/theme.css"
		}
	},
	"peerDependencies": {
		"@sjvair/sdk": "npm:@jsr/sjvair__sdk@^5.0.0-beta.2",
		"svelte": "^5.57.0"
	},
	"dependencies": {
		"@maptiler/sdk": "~4.2.0",
		"@turf/area": "^7.4.0",
		"@turf/clusters-dbscan": "^7.4.0",
		"@turf/helpers": "^7.4.0",
		"@types/geojson": "^7946.0.16",
		"color2k": "^2.0.4",
		"esm-env": "^1.2.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@maplibre/maplibre-gl-style-spec": "^24.10.0",
		"@playwright/test": "^1.64.1",
		"@sjvair/sdk": "npm:@jsr/sjvair__sdk@5.0.0-beta.10",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.0",
		"@vitest/browser-playwright": "^5.0.5",
		"axe-core": "^4.14.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"keywords": [
		"svelte"
	]
}
